make/

# Fuzzing output.  The seed corpus under test/fuzz/corpus/ is tracked on
# purpose — it is the regression corpus and is regenerated by
# test/fuzz/make_corpus.py — but crash reproducers and the clang/libFuzzer
# binaries are per-run and are not.
#
# bin/fuzz-corpus/ is the *working* corpus: the directory libFuzzer writes its
# discoveries into, and the one CI carries between runs through actions/cache.
# It is deliberately not tracked.  It used to be the seed directory, and a few
# nights of that put 7158 unreadable files into the repository — see the note at
# the top of test/fuzz/run_fuzz.sh.
bin/fuzz-artifacts/
bin/fuzz-corpus/
bin/fuzz-libfuzzer/

# The same directory, unanchored, because the replay driver writes its crash
# artifact relative to the working directory rather than to bin/.  Running a
# target by hand from the repository root — which is how anyone reproduces a
# failure — therefore drops fuzz-artifacts/ here instead, where the anchored
# rule above does not reach it.  Found by doing exactly that.
fuzz-artifacts/

# Load harness and suite logs
suite-*.log
load-*.log
release-build.log

__pycache__/
*.pyc

# Benchmark results
test/benchmark/results/

# Packages
*.deb
*.rpm
# Project files
CLAUDE.md
CONTRIBUTING.md

# Agent worktrees.  git checkouts of this repository living inside it; adding
# them would commit a copy of the tree to itself.  Only worktrees/ — anything
# else under .claude/ is ordinary project configuration and stays trackable.
.claude/worktrees/

# IDE and editor
.vscode/
.idea/
.vs/
.DS_Store
