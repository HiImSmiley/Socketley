[Unit]
Description=Socketley Runtime Daemon
Documentation=man:socketley(1)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/socketley daemon
Restart=on-failure
RestartSec=5

# Directories
RuntimeDirectory=socketley
StateDirectory=socketley
ConfigurationDirectory=socketley

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
# Read-only rather than hidden, because scripts, certificates and static
# roots are commonly kept in a home directory and --lua, --cert and --http
# name them there; nothing under /home is ever written.
ProtectHome=read-only
ReadWritePaths=/var/lib/socketley /run/socketley

# User
User=socketley
Group=socketley

[Install]
WantedBy=multi-user.target
