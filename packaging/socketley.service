[Unit]
Description=Socketley Runtime Daemon
Documentation=man:socketley(1)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/socketley daemon
Restart=on-failure
RestartSec=5
# Every connection is a descriptor, and systemd's default soft limit of 1024 would cap a runtime near a thousand.
LimitNOFILE=1048576

# Directories
RuntimeDirectory=socketley
StateDirectory=socketley
ConfigurationDirectory=socketley

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
# Read-only rather than hidden, because scripts, certificates and static
# roots are commonly kept in a home directory and --lua, --cert and --http
# name them there; nothing under /home is ever written.
ProtectHome=read-only
ReadWritePaths=/var/lib/socketley /run/socketley

# User
User=socketley
Group=socketley
# Ports below 1024 -- a dns runtime's 53, and 80 and 443 -- without root. Only this one capability, and NoNewPrivileges
# above keeps any program a runtime starts from gaining more.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
